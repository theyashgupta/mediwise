{
  "name": "@mediwise/landing",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node scripts/copy-brand.mjs && next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include=src/**/*.{ts,tsx} --coverage.reporter=text-summary --coverage.thresholds.statements=36 --coverage.thresholds.branches=17 --coverage.thresholds.functions=38 --coverage.thresholds.lines=38"
  },
  "dependencies": {
    "@mediwise/design-tokens": "workspace:*",
    "@mediwise/engine": "workspace:*",
    "@mediwise/shared": "workspace:*",
    "lucide-react": "1.55.0",
    "next": "16.3.8",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@mediwise/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  }
}
