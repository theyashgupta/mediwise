# Base URL of the API. Default http://localhost:3001.
VITE_API_URL=
# Supabase project URL, https://<ref>.supabase.co. Required.
VITE_SUPABASE_URL=
# Supabase anon (publishable) key. Used for sign-in only, the web never reads tables. Required.
VITE_SUPABASE_ANON_KEY=
# Set to true to show the credit packs and the Buy button. Set it only when the API has PAYMENTS_ENABLED=true. Default false.
VITE_PAYMENTS_ENABLED=false
# sandbox or production. Must match CASHFREE_ENV on the API. Default sandbox.
VITE_CASHFREE_MODE=sandbox
# Public origin of this app, with no trailing slash. The build writes it into the OG tags, site.webmanifest, robots.txt and sitemap.xml. Default http://localhost:5173.
VITE_APP_ORIGIN=
# Address of the landing page. The footer links to it. Default http://localhost:3000.
VITE_LANDING_URL=
