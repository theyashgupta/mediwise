# Postgres connection string of the Supabase project. Use the session-mode pooler URI (port 5432). The CMS tables live in schema cms.
DATABASE_URI=
# Random string of 32 or more characters, for example `openssl rand -hex 32`. Signs the admin sessions. Server only.
PAYLOAD_SECRET=
# Email of the one admin user. The seed creates this user when no user has the email.
CMS_ADMIN_EMAIL=
# Password of the one admin user. The seed uses it only when it creates the user.
CMS_ADMIN_PASSWORD=
# GitHub token that may send repository_dispatch to theyashgupta/mediwise (fine-grained, Contents read and write). Empty means no dispatch.
GITHUB_DISPATCH_TOKEN=
# Public URL of the CMS, with no trailing slash. Default empty. Local: http://localhost:3002.
NEXT_PUBLIC_SERVER_URL=
