{
  "name": "@mediwise/api",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include=src/**/*.{ts,tsx} --coverage.reporter=text-summary --coverage.thresholds.statements=75 --coverage.thresholds.branches=72 --coverage.thresholds.functions=75 --coverage.thresholds.lines=76",
    "test:db": "NODE_ENV=test vitest run --config vitest.db.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=development --env-file-if-exists=.env src/db/seed.ts",
    "db:claim-dev-data": "tsx --conditions=development --env-file-if-exists=.env src/db/claim-dev-data.ts",
    "db:seed-history": "tsx --conditions=development --env-file-if-exists=.env src/db/seed-history.ts",
    "db:reread-reports": "tsx --conditions=development --env-file-if-exists=.env src/db/reread-reports.ts",
    "db:backfill-titles": "tsx --conditions=development --env-file-if-exists=.env src/db/backfill-report-titles.ts",
    "credits:grant": "tsx --conditions=development --env-file-if-exists=.env src/db/grant-credits.ts",
    "eval:mapping": "tsx --conditions=development src/eval/eval-mapping.ts",
    "eval:extraction": "tsx --conditions=development --env-file-if-exists=.env src/eval/eval-extraction.ts",
    "eval:narrative": "tsx --conditions=development --env-file-if-exists=.env src/eval/eval-narrative.ts",
    "eval:findings": "tsx --conditions=development --env-file-if-exists=.env src/eval/eval-findings.ts",
    "eval:assistant": "tsx --conditions=development --env-file-if-exists=.env src/eval/eval-assistant.ts",
    "assistant:review": "tsx --conditions=development --env-file-if-exists=.env src/eval/review-assistant.ts",
    "review:hindi": "UPDATE_REVIEW=1 vitest run src/eval/hindi-review.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@hono/node-server": "2.1.4",
    "@mediwise/engine": "workspace:*",
    "@mediwise/shared": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "cashfree-pg": "6.0.6",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mediwise/config": "workspace:*",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
