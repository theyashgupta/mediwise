# development, production or test. Default development. Test mode runs every request as DEV_USER_ID.
NODE_ENV=
# Port the API listens on. Default 3001.
PORT=
# Web app origins that CORS allows, separated by commas. The first one is the main app origin: Cashfree sends the buyer back there. Default http://localhost:5173.
CORS_ORIGINS=
# Old name for a single CORS origin. The API reads it only when CORS_ORIGINS is empty. Remove it after one release.
WEB_ORIGIN=
# Postgres connection string of the Supabase project. Use the pooler URI (Supabase dashboard, Connect).
DATABASE_URL=
# Supabase project URL, https://<ref>.supabase.co.
SUPABASE_URL=
# Supabase service role key. Server only, never ship it to the web app.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy JWT secret of the Supabase project (dashboard, Project Settings, JWT Keys). Optional. Set it only while the project
# signs access tokens with HS256. ES256 and RS256 tokens verify against the project's public JWKS without it.
SUPABASE_JWT_SECRET=
# User id every request runs as when NODE_ENV=test. Default dev-user.
DEV_USER_ID=
# Anthropic API key used by the report worker. The API starts without it, but no report can be read.
ANTHROPIC_API_KEY=
# Claude model that maps the test names no alias matches. Default claude-sonnet-5-5.
ANTHROPIC_MODEL=
# Claude model that reads the values off a report and maps leftover names. Default claude-haiku-5-5.
ANTHROPIC_EXTRACT_MODEL=
# Claude model that writes the report narrative. Default claude-haiku-5-5.
ANTHROPIC_NARRATIVE_MODEL=
# Claude model that writes the finding bodies. Default claude-haiku-5-5.
ANTHROPIC_FINDINGS_MODEL=
# Set to true to run the report worker inside this API process. Default false.
RUN_WORKER=
# Set to true only in the e2e suite. The worker then reads the two golden samples from fixtures/golden and never calls Claude.
# The API refuses to start with it in production. Default false.
CLAUDE_STUB=
# Monthly Claude spend cap in US cents. Over the cap the worker pauses every read until the next month or a higher cap. Default 2000.
CLAUDE_MONTHLY_CAP_CENTS=
# Set to true to refuse every new report upload. Reads already queued still run. Default false.
CLAUDE_HARD_STOP=
# Supabase user id that may open /admin, call GET /admin/spend and GET /admin/overview, and sees costCents in GET /reports/:id. When it is empty, nobody does.
ADMIN_USER_ID=
# Set to true to turn on buying report credits. When false, every /payments route answers 404. Default false.
PAYMENTS_ENABLED=
# Cashfree Payment Gateway app id (Cashfree dashboard, Developers, API keys). Required when PAYMENTS_ENABLED=true.
CASHFREE_APP_ID=
# Cashfree secret key. It also signs the webhooks. Server only. Required when PAYMENTS_ENABLED=true.
CASHFREE_SECRET_KEY=
# sandbox or production. Use sandbox with test keys. Default sandbox.
CASHFREE_ENV=
# Public URL of POST /payments/webhook, sent to Cashfree with each order. Optional. Without it, only the dashboard webhook applies.
PAYMENTS_WEBHOOK_URL=
# Set to true only in the e2e suite. An order then gets a made-up payment session and never calls Cashfree. Webhooks are
# still checked with CASHFREE_SECRET_KEY. The API refuses to start with it in production. Default false.
CASHFREE_STUB=

# Assistant: off until the quota and the UI ship
ASSISTANT_ENABLED=false
ANTHROPIC_ASSISTANT_MODEL=claude-haiku-5-5
# Review month: with ASSISTANT_ENABLED, only accounts that agree to a human review of their questions can ask. Default false.
ASSISTANT_REVIEW=false

# Key for the HMAC of the user id that each Claude call sends as metadata.user_id. Use a random string of 32 or more characters. Empty sends no user id.
ANTHROPIC_USER_SALT=

# Master key of the field encryption: 32 random bytes as base64, for example `openssl rand -base64 32`. Required.
DATA_KEY_V1=
# Optional newer master key during a rotation. Then run pnpm db:rewrap-keys.
DATA_KEY_V2=
