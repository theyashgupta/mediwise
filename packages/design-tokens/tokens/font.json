{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] },
      "display": { "$value": ["Instrument Serif", "ui-serif", "Georgia", "serif"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": { "value": 0.75, "unit": "rem" } },
      "sm": { "$value": { "value": 0.875, "unit": "rem" } },
      "base": { "$value": { "value": 0.9375, "unit": "rem" } },
      "lg": { "$value": { "value": 1.0625, "unit": "rem" } },
      "xl": { "$value": { "value": 1.25, "unit": "rem" } },
      "2xl": { "$value": { "value": 1.5, "unit": "rem" } },
      "3xl": { "$value": { "value": 1.875, "unit": "rem" } },
      "display": { "$value": { "value": 2.25, "unit": "rem" } }
    },
    "line-height": {
      "$type": "dimension",
      "xs": { "$value": { "value": 1, "unit": "rem" } },
      "sm": { "$value": { "value": 1.25, "unit": "rem" } },
      "base": { "$value": { "value": 1.5, "unit": "rem" } },
      "lg": { "$value": { "value": 1.625, "unit": "rem" } },
      "xl": { "$value": { "value": 1.75, "unit": "rem" } },
      "2xl": { "$value": { "value": 2, "unit": "rem" } },
      "3xl": { "$value": { "value": 2.25, "unit": "rem" } },
      "display": { "$value": { "value": 2.5, "unit": "rem" } }
    },
    "letter-spacing": {
      "$type": "dimension",
      "display": { "$value": { "value": -0.01, "unit": "em" } }
    }
  }
}
