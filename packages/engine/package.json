{
  "name": "@mediwise/engine",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include=src/**/*.{ts,tsx} --coverage.reporter=text-summary --coverage.thresholds.statements=93 --coverage.thresholds.branches=88 --coverage.thresholds.functions=97 --coverage.thresholds.lines=94"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mediwise/config": "workspace:*"
  }
}
