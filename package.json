{
  "name": "mediwise",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run typecheck lint test --concurrency 2",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "coverage": "turbo run coverage --concurrency 2",
    "test:db": "pnpm --filter @mediwise/api test:db",
    "e2e": "pnpm --filter @mediwise/e2e e2e",
    "perf": "pnpm --filter @mediwise/e2e perf",
    "size": "turbo run build --filter @mediwise/landing --filter @mediwise/web^... && pnpm --filter @mediwise/web exec vite build --manifest && node scripts/bundle-size.mjs",
    "format": "prettier --write .",
    "eval:mapping": "pnpm --filter @mediwise/api eval:mapping",
    "eval:extraction": "pnpm --filter @mediwise/api eval:extraction",
    "eval:narrative": "pnpm --filter @mediwise/api eval:narrative",
    "eval:findings": "pnpm --filter @mediwise/api eval:findings"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@mediwise/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "prettier": "@mediwise/config/prettier"
}
